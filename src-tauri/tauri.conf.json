{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AVA Coffee K300",
  "version": "0.1.0",
  "identifier": "com.avacoffee.k300",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "AVA Coffee K300 - POS System",
        "label": "main",
        "fullscreen": true,
        "maximized": true,
        "resizable": true,
        "width": 1920,
        "height": 1080,
        "minWidth": 1024,
        "minHeight": 768,
        "zoomHotkeysEnabled": false,
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding",
        "url": "pos.html"
      },
      {
        "title": "AVA Coffee - Màn Hình Khách Hàng",
        "label": "customer_display",
        "fullscreen": false,
        "resizable": true,
        "width": 1024,
        "height": 600,
        "visible": false,
        "url": "customer-display.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
